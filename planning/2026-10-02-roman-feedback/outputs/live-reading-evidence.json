{
  "verifiedTexts": {
    "texts": [
      {
        "id": "179:2131",
        "name": "평면 · BASIC 한줄 1",
        "text": "로마 공화정 후기부터 제국 시기까지\n벽·지붕·항구에 널리 씀"
      },
      {
        "id": "179:2143",
        "name": "평면 · 기록2",
        "text": "비트루비우스·\n플리니우스의 책"
      },
      {
        "id": "179:2145",
        "name": "평면 · 연구2",
        "text": "옛 조각 살피고\n다시 만들어 시험"
      },
      {
        "id": "179:2148",
        "name": "평면 · BASIC 한줄 2",
        "text": "기록과, 옛 조각 연구·재현 실험으로\n재료와 성질을 알게 됨"
      },
      {
        "id": "200:103",
        "name": "전제 1 · 로마 콘크리트란?",
        "text": "전제 1 · 로마 콘크리트란?"
      },
      {
        "id": "204:8733",
        "name": "본문",
        "text": "석회 + 화산재 + 물이 만나\n돌처럼 굳고, 굳은 뒤에도\n반응이 이어짐"
      },
      {
        "id": "204:8735",
        "name": "본문",
        "text": "바닷물이 스며도 무너지지\n않고 새 결정이 자라\n더 단단해짐"
      },
      {
        "id": "204:8743",
        "name": "본문",
        "text": "마른 석회와 화산재를 먼저\n섞고 물을 부으면 뜨거워지며\n빨리 굳음"
      },
      {
        "id": "204:8745",
        "name": "본문",
        "text": "다 녹지 않은 흰 석회 알갱이가\n남음 → ④에서 금을 메우는 재료"
      },
      {
        "id": "204:8747",
        "name": "※ 한계",
        "text": "※ 폼페이·성벽 조각에서 확인 —\n콜로세움에서 직접 본 것은 아님"
      },
      {
        "id": "204:8755",
        "name": "본문",
        "text": "아치와 둥근 천장으로 무게를\n누르는 힘으로만 받음 ·\n철근이 없어 녹슬 일도 없음"
      },
      {
        "id": "204:8757",
        "name": "본문",
        "text": "아래는 무거운 돌, 위로 갈수록\n가벼운 돌·벽돌 · 12m 넘는\n기초 고리가 무게를 땅까지"
      },
      {
        "id": "204:8765",
        "name": "본문",
        "text": "80년에 지은 콜로세움은\n지금도 로마에 서 있음"
      },
      {
        "id": "204:8772",
        "name": "본문",
        "text": "재료①·만들기②·짓기③·\n고치기④가 함께 맞물려\n2천 년을 버텼다"
      },
      {
        "id": "204:8774",
        "name": "※ 한계",
        "text": "※ 스스로 메우는 힘은\n다른 유적·실험의 결과 —\n콜로세움에서 직접 확인 안 됨"
      },
      {
        "id": "204:8782",
        "name": "본문",
        "text": "금에 스민 물이 석회 알갱이를 녹였다가\n다시 굳어 금을 메움"
      },
      {
        "id": "204:8784",
        "name": "본문",
        "text": "계속 쓰인 건물은 계속 고쳐짐 —\n남아 있다고 다치지 않은 것은 아님"
      },
      {
        "id": "204:8786",
        "name": "※ 한계",
        "text": "※ 다른 유적 조각·재현 실험의 결과 —\n콜로세움에서 직접 확인 안 됨"
      },
      {
        "id": "211:1874",
        "name": "DETAIL 소제목",
        "text": "① 원리 · 왜 굳고,\n더 단단해지나"
      },
      {
        "id": "211:1876",
        "name": "DETAIL 본문",
        "text": "석회가 화산재 속 성분과 만나\n돌을 붙이는 단단한 풀이 됨"
      },
      {
        "id": "211:1878",
        "name": "DETAIL 본문",
        "text": "바닷물이 스미면 보통 온도\n(약 20℃)에서도 새 결정이 자람"
      },
      {
        "id": "211:1882",
        "name": "DETAIL 본문",
        "text": "마른 석회는 물을 만나면\n스스로 열을 냄"
      },
      {
        "id": "211:1884",
        "name": "DETAIL 본문",
        "text": "남은 석회 알갱이 =\n몇 mm 크기의,\n잘 부서지는 칼슘 창고"
      },
      {
        "id": "211:1886",
        "name": "DETAIL 소제목",
        "text": "③ 원리 · 잘라 본 벽 —\n위는 가볍게,\n아래는 두껍게"
      },
      {
        "id": "211:1888",
        "name": "DETAIL 본문",
        "text": "돌과 콘크리트는\n누르는 힘엔 강하고\n당기는 힘엔 약함\n→ 아치로 누르는 힘만\n받게 함"
      },
      {
        "id": "211:1890",
        "name": "DETAIL 본문",
        "text": "위가 가벼우면 아래로\n쌓이는 무게도 줄어듦"
      },
      {
        "id": "211:1892",
        "name": "DETAIL 소제목",
        "text": "④ 원리 · 금이\n메워지는 순서"
      },
      {
        "id": "211:1926",
        "name": "비네트 설명 1",
        "text": "1 금이 흰\n석회 알갱이를\n지나감"
      },
      {
        "id": "227:26098",
        "name": "SUPPORT 본문",
        "text": "바닷물 속에서 새 결정이\n자라 더 단단해짐"
      },
      {
        "id": "227:26107",
        "name": "SUPPORT 본문",
        "text": "마른 석회를 섞어 둔 원료 더미"
      },
      {
        "id": "227:26118",
        "name": "SUPPORT 본문",
        "text": "흰 석회 알갱이와\n금을 메운 흰 결정"
      },
      {
        "id": "227:26127",
        "name": "SUPPORT 본문",
        "text": "재현 실험 — 금으로 흐르던\n물이 2주 안에 멈춤,\n알갱이 없으면 계속 샘"
      },
      {
        "id": "231:21383",
        "name": "읽는 법 · route",
        "text": "굵은 점선 ① 출발 → ⑤ = 재료가\n콜로세움이 되기까지의 길"
      },
      {
        "id": "231:21386",
        "name": "읽는 법 · disc",
        "text": "검은 원 번호 옆의 굵은 기울인 글 =\n그 단계의 설명"
      },
      {
        "id": "231:21389",
        "name": "읽는 법 · badge",
        "text": "같은 번호 배지의 확대 모형 = 원리"
      },
      {
        "id": "231:21395",
        "name": "읽는 법 · pin",
        "text": "점선 핀과 번호 확인 = 증거가 나온 곳"
      },
      {
        "id": "231:21400",
        "name": "읽는 법 · ruler",
        "text": "맨 아래 눈금 = 지나온 시간"
      },
      {
        "id": "179:2155",
        "name": "평면 · 출처 자리",
        "text": "출처 자리 (스케치에서는 생략)"
      }
    ]
  },
