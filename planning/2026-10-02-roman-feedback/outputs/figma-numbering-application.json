    {
      "id": "179:2130",
      "t": "틀에 부어 굳힘"
    },
    {
      "id": "179:2131",
      "t": "로마 공화정 후기부터 제국 시기까지\n벽·지붕·항구에 널리 씀"
    },
    {
      "id": "179:2142",
      "t": "로마 때 기록"
    },
    {
      "id": "179:2143",
      "t": "비트루비우스·\n플리니우스의 책"
    },
    {
      "id": "179:2144",
      "t": "오늘의 연구"
    },
    {
      "id": "179:2145",
      "t": "옛 조각 살피고\n다시 만들어 시험"
    },
    {
      "id": "179:2146",
      "t": "살펴볼 건물"
    },
    {
      "id": "179:2147",
      "t": "콜로세움 · 로마 · 80년"
    },
    {
      "id": "179:2148",
      "t": "기록과, 옛 조각 연구·재현 실험으로\n재료와 성질을 알게 됨"
    },
    {
      "id": "179:2166",
      "t": "1"
    },
    {
      "id": "179:2167",
      "t": "2"
    },
    {
      "id": "179:2168",
      "t": "3"
    },
    {
      "id": "179:2169",
      "t": "4"
    },
    {
      "id": "179:2170",
      "t": "5"
    },
    {
      "id": "200:96",
      "t": "로마 콘크리트"
    },
    {
      "id": "200:97",
      "t": "어떻게 2천 년을 버텼을까?"
    },
    {
      "id": "200:99",
      "t": "중심 · 질문"
    },
    {
      "id": "318:80",
      "t": "출발"
    },
    {
      "id": "200:103",
      "t": "전제 · 로마 콘크리트란?"
    },
    {
      "id": "200:107",
      "t": "전제 · 어떻게 알았나"
    },
    {
      "id": "204:8729",
      "t": "1"
    },
    {
      "id": "204:8730",
      "t": "굳은 뒤에도"
    },
    {
      "id": "204:8731",
      "t": "단단해지는\n재료"
    },
    {
      "id": "204:8733",
      "t": "석회 + 화산재 + 물이 만나\n돌처럼 굳고, 굳은 뒤에도\n반응이 이어짐"
    },
    {
      "id": "204:8735",
      "t": "바닷물이 스며도 무너지지\n않고 새 결정이 자라\n더 단단해짐"
    },
    {
      "id": "204:8739",
      "t": "2"
    },
    {
      "id": "204:8740",
      "t": "뜨겁게 섞어"
    },
    {
      "id": "204:8741",
      "t": "빨리 굳힘"
    },
    {
      "id": "204:8743",
      "t": "마른 석회와 화산재를 먼저\n섞고 물을 부으면 뜨거워지며\n빨리 굳음"
    },
    {
      "id": "204:8745",
      "t": "다 녹지 않은 흰 석회 알갱이가\n남음 → ④에서 금을 메우는 재료"
    },
    {
      "id": "204:8747",
      "t": "※ 폼페이·성벽 조각에서 확인 —\n콜로세움에서 직접 본 것은 아님"
    },
    {
      "id": "204:8751",
      "t": "3"
    },
    {
      "id": "204:8752",
      "t": "누르는 힘만"
    },
    {
      "id": "204:8753",
      "t": "받게 짓기"
    },
    {
      "id": "204:8755",
      "t": "아치와 둥근 천장으로 무게를\n누르는 힘으로만 받음 ·\n철근이 없어 녹슬 일도 없음"
    },
    {
      "id": "204:8757",
      "t": "아래는 무거운 돌, 위로 갈수록\n가벼운 돌·벽돌 · 12m 넘는\n기초 고리가 무게를 땅까지"
    },
    {
      "id": "204:8761",
      "t": "5"
    },
    {
      "id": "204:8762",
      "t": "약 1,950년째"
    },
    {
      "id": "204:8763",
      "t": "서 있음"
    },
    {
      "id": "204:8765",
      "t": "80년에 지은 콜로세움은\n지금도 로마에 서 있음"
    },
    {
      "id": "204:8768",
      "t": "중심 · 답"
    },
    {
      "id": "204:8770",
      "t": "한 가지 비결이 아니다"
    },
    {
      "id": "204:8772",
      "t": "재료·만들기·짓기·\n고치기가 함께 맞물려\n2천 년을 버텼다"
    },
    {
      "id": "204:8774",
      "t": "※ 스스로 메우는 힘은\n다른 유적·실험의 결과 —\n콜로세움에서 직접 확인 안 됨"
    },
    {
      "id": "204:8778",
      "t": "4"
    },
    {
      "id": "204:8779",
      "t": "금이 가도"
    },
    {
      "id": "204:8780",
      "t": "메우고, 쓰면서 고침"
    },
    {
      "id": "204:8782",
      "t": "금에 스민 물이 석회 알갱이를 녹였다가\n다시 굳어 금을 메움"
    },
    {
      "id": "204:8784",
      "t": "계속 쓰인 건물은 계속 고쳐짐 —\n남아 있다고 다치지 않은 것은 아님"
    },
    {
      "id": "204:8786",
      "t": "※ 다른 유적 조각·재현 실험의 결과 —\n콜로세움에서 직접 확인 안 됨"
    },
    {
      "id": "320:78",
      "t": "12m+"
    },
    {
      "id": "209:1855",
      "t": "바닷물 속"
    },
    {
      "id": "209:1858",
      "t": "새 결정"
    },
    {
      "id": "208:119",
      "t": "석회 알갱이"
    },
    {
      "id": "211:1874",
      "t": "재료 원리 · 해수 속\n새 결정"
    },
    {
      "id": "211:1876",
      "t": "석회가 화산재 속 성분과 만나\n돌을 붙이는 단단한 풀이 됨"
    },
    {
      "id": "211:1878",
      "t": "바닷물이 스미면 보통 온도\n(약 20℃)에서도 새 결정이 자람"
    },
    {
      "id": "211:1880",
      "t": "제작 원리 · 열과 석회"
    },
    {
      "id": "211:1882",
      "t": "마른 석회는 물을 만나면\n스스로 열을 냄"
    },
    {
      "id": "211:1884",
      "t": "남은 석회 알갱이 =\n몇 mm 크기의,\n잘 부서지는 칼슘 창고"
    },
    {
      "id": "211:1886",
      "t": "구조 원리 · 벽과 기초\n위는 가볍게,\n아래는 두껍게"
    },
    {
      "id": "211:1888",
      "t": "돌과 콘크리트는\n누르는 힘엔 강하고\n당기는 힘엔 약함\n→ 아치로 누르는 힘만\n받게 함"
    },
    {
      "id": "211:1890",
      "t": "위가 가벼우면 아래로\n쌓이는 무게도 줄어듦"
    },
    {
      "id": "211:1892",
      "t": "균열 원리 · 금이\n메워지는 순서"
    },
    {
      "id": "211:1905",
      "t": "가벼운 벽돌"
    },
    {
      "id": "211:1909",
      "t": "중간 돌"
    },
    {
      "id": "211:1913",
      "t": "무거운 돌"
    },
    {
      "id": "211:1917",
      "t": "기초 12m+"
    },
    {
      "id": "211:1926",
      "t": "금이 흰\n석회 알갱이를\n지나감"
    },
    {
      "id": "211:1939",
      "t": "스민 물이\n칼슘을 녹임"
    },
    {
      "id": "211:1949",
      "t": "다시 굳어\n금을 메움"
    },
    {
      "id": "227:26091",
      "t": "로마 항구 방파제 조각"
    },
    {
      "id": "227:26096",
      "t": "결정 관찰"
    },
    {
      "id": "227:26098",
      "t": "바닷물 속에서 새 결정이\n자라 더 단단해짐"
    },
    {
      "id": "227:26100",
      "t": "폼페이 공사현장(79년)"
    },
    {
      "id": "227:26105",
      "t": "배합 흔적"
    },
    {
      "id": "227:26107",
      "t": "마른 석회를 섞어 둔 원료 더미"
    },
    {
      "id": "227:26109",
      "t": "프리베르눔\n성벽 조각"
    },
    {
      "id": "227:26116",
      "t": "석회·결정 관찰"
    },
    {
      "id": "227:26118",
      "t": "흰 석회 알갱이와\n금을 메운 흰 결정"
    },
    {
      "id": "227:26120",
      "t": "오늘의 실험실"
    },
    {
      "id": "227:26125",
      "t": "균열 충전 실험"
    },
    {
      "id": "227:26127",
      "t": "재현 실험 — 금으로 흐르던\n물이 2주 안에 멈춤,\n알갱이 없으면 계속 샘"
    },
    {
      "id": "228:83",
      "t": "공화정 후기~제국"
    },
    {
      "id": "228:84",
      "t": "벽·지붕·항구에 널리 씀"
    },
    {
      "id": "228:86",
      "t": "79년"
    },
    {
      "id": "228:89",
      "t": "폼페이 공사현장 원료 더미"
    },
    {
      "id": "228:91",
      "t": "80년"
    },
    {
      "id": "228:92",
      "t": "콜로세움 완공"
    },
    {
      "id": "228:94",
      "t": "1349년"
    },
    {
      "id": "228:97",
      "t": "지진 · 남쪽 바깥벽 무너짐"
    },
    {
      "id": "228:99",
      "t": "19세기"
    },
    {
      "id": "228:102",
      "t": "벽돌 버팀벽으로 받침"
    },
    {
      "id": "228:104",
      "t": "2017~2025년"
    },
    {
      "id": "228:105",
      "t": "옛 조각 연구 · 재현 실험"
    },
    {
      "id": "228:107",
      "t": "오늘"
    },
    {
      "id": "228:110",
      "t": "약 1,950년째 서 있음"
    },
    {
      "id": "231:21382",
      "t": "읽는 법"
    },
    {
      "id": "231:21383",
      "t": "굵은 점선 = 코어를 읽는 순서\n재료에서 보수까지 이어지는 길"
    },
    {
      "id": "231:21386",
      "t": "검은 원 번호 · +30° 글 =\n코어의 핵심 설명"
    },
    {
      "id": "231:21389",
      "t": "−30° 글 · 무번호 확대 모형 = 원리"
    },
    {
      "id": "231:21395",
      "t": "점선 핀 · 지명·관찰명 = 확인 근거"
    },
    {
      "id": "231:21398",
      "t": "회색 ※ 줄 = 한계"
    },
    {
      "id": "231:21399",
      "t": "※"
    },
    {
      "id": "231:21400",
      "t": "맨 아래 눈금 = 지나온 시간"
    },
    {
      "id": "179:2155",
      "t": "출처 자리 (스케치에서는 생략)"
    }
  ]
}
